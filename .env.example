# ----------------------------------------------------------------------------
# ZTOps — example environment file.
# Copy to `.env`, fill in values. `.env` is gitignored. NEVER commit secrets.
# This file is the documentation for every env var the app reads. If you add
# a new var to settings, you MUST add it here with a comment, or CI fails.
# ----------------------------------------------------------------------------

# ---------- Django core ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated. Production: ztops.zerotrustoffsec.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# NEVER set DEBUG=True in any environment outside one-off local debugging.
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---------- Database (Postgres) ----------
POSTGRES_USER=ztops
POSTGRES_PASSWORD=
POSTGRES_DB=ztops
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional convenience var; if set, overrides individual POSTGRES_* fields.
DATABASE_URL=

# Separate, less-privileged role used by Celery workers (see deploy/roles.sql).
# Cannot read auth tables, cannot read audit log, cannot ALTER schema.
CELERY_DB_USER=ztops_worker
CELERY_DB_PASSWORD=

# Read-only role for forensic audit-log retrieval. Used out-of-band, not by the app.
AUDIT_READER_USER=ztops_audit_reader
AUDIT_READER_PASSWORD=

# ---------- Redis / Celery ----------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------- WebAuthn ----------
# RP_ID must match the host the user sees in the browser. No scheme, no port.
WEBAUTHN_RP_ID=localhost
# Quoted because the value contains shell-special chars (parens).
WEBAUTHN_RP_NAME="ZTOps (dev)"
# Comma-separated origins. Production: https://ztops.zerotrustoffsec.com
WEBAUTHN_RP_ORIGINS=http://localhost:8000

# ---------- Agent API tokens (/api/v1/) ----------
# All optional; defaults shown. The 90-day hard maximum lifetime is a code +
# DB constraint and cannot be raised from the environment.
API_TOKEN_DEFAULT_LIFETIME_DAYS=30
# Tokens unused for this many days are rejected even before they expire.
API_TOKEN_IDLE_TIMEOUT_DAYS=14
API_TOKEN_MAX_ACTIVE_PER_USER=10
# Per-token request rate (DRF rate syntax).
API_TOKEN_THROTTLE_RATE=120/m
# Failed bearer-auth attempts allowed per client IP before 429.
API_AUTH_FAILURE_RATE=10/m

# ---------- ClamAV (file-upload scanning) ----------
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ---------- Signed-URL attachment serving ----------
# Independent from DJANGO_SECRET_KEY so rotating one does not invalidate the other.
ATTACHMENT_SIGNING_KEY=
# Path OUTSIDE Django MEDIA_ROOT. Served only via the signed-URL endpoint.
ATTACHMENT_STORAGE_PATH=/var/lib/ztops/attachments

# ---------- Trusted proxies ----------
# Only X-Forwarded-* headers from these addresses are honored. Caddy's address.
TRUSTED_PROXY_IPS=127.0.0.1

# ---------- Email (only for security@ and account-recovery notifications) ----------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@zerotrustoffsec.com

# ---------- Observability ----------
LOG_LEVEL=INFO
# JSON in prod, console in dev.
LOG_FORMAT=console
